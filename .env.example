# Copie para backend/.env (nunca faça commit do .env). Todas as variáveis são opcionais.
# CANECA_DATA_DIR=~/.local/share/caneca-quest
# CANECA_HOST=127.0.0.1
# CANECA_PORT=8765
# CANECA_STATIC_DIR=../apps/web/dist
# CANECA_OLLAMA_URL=http://127.0.0.1:11434
# CANECA_API_TOKEN=            # exige "Authorization: Bearer <token>" em /api
# CANECA_OPENAI_API_KEY=       # provedores em nuvem (também configuráveis pela interface)
# CANECA_OPENAI_BASE_URL=https://api.openai.com/v1
# CANECA_ANTHROPIC_API_KEY=
# CANECA_LOG_LEVEL=info
